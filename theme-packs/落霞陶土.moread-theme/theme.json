{
  "format": "moread-theme",
  "version": 2,
  "name": "落霞 · 陶土",
  "home": {
    "enabled": true
  },
  "style": {
    "enabled": true
  },
  "theme": {
    "mode": "dark",
    "primary": "#ea8f6d",
    "secondary": "#e9c886",
    "componentColors": {
      "appBg": "#120e0d",
      "titlebarBg": "#1b1817",
      "sidebarBg": "#0c0908",
      "surfaceBg": "#171210",
      "editorBg": "#181311",
      "paperBg": "#1b1513",
      "paperSoft": "#292321",
      "statusBg": "#130f0e",
      "ink": "#f0e6dd",
      "inkSoft": "#bbb2ab",
      "muted": "#8e8781",
      "faint": "#6b6460",
      "line": "#37302d",
      "lineSoft": "#2d2724",
      "codeBg": "#161110",
      "codeInk": "#f0e6dd",
      "codeHead": "#221d1c",
      "tableHead": "#1d1817",
      "quoteBg": "#231a16",
      "selection": "#724839",
      "diagramPrimary": "#ea8f6d",
      "diagramSecondary": "#e9c886"
    },
    "brandIcon": {
      "type": "image",
      "value": "data:image/png;base64,"
    },
    "stickers": [
      {
        "type": "emoji",
        "value": "🌇",
        "x": 92,
        "y": 12,
        "size": 32,
        "rotation": 9,
        "scope": "welcome"
      }
    ],
    "customButtons": [
      {
        "label": "日期落款",
        "icon": "📅",
        "script": "const d = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\nawait app.insert(`\\n\\n> ${stamp} · 落霞 · 陶土\\n`);\napp.toast('落款已插入');"
      },
      {
        "label": "选中成引",
        "icon": "❝",
        "script": "const picked = app.selection || '';\nif (!picked.trim()) { app.toast('先选中一段文字'); return; }\nconst quoted = picked.split('\\n').map((line) => `> ${line}`).join('\\n');\nawait app.replaceSelection(quoted);\napp.toast('已围成引用');"
      }
    ]
  }
}
