{
  "format": "moread-theme",
  "version": 2,
  "name": "藕荷 · 晚照",
  "home": {
    "enabled": true
  },
  "style": {
    "enabled": true
  },
  "theme": {
    "mode": "light",
    "primary": "#7c5699",
    "secondary": "#c2718c",
    "componentColors": {
      "appBg": "#f2e7ef",
      "titlebarBg": "#f7f1f6",
      "sidebarBg": "#eadfe7",
      "surfaceBg": "#f8f0f6",
      "editorBg": "#f9f3f7",
      "paperBg": "#fdf8fb",
      "paperSoft": "#f6edf3",
      "statusBg": "#f5ebf2",
      "ink": "#2e2230",
      "inkSoft": "#5c515d",
      "muted": "#898089",
      "faint": "#aaa2aa",
      "line": "#e6e0e5",
      "lineSoft": "#f0eaee",
      "codeBg": "#f6edf3",
      "codeInk": "#2e2230",
      "codeHead": "#f4eaf1",
      "tableHead": "#f5ebf2",
      "quoteBg": "#f0e6ef",
      "selection": "#d6c7de",
      "diagramPrimary": "#7c5699",
      "diagramSecondary": "#c2718c"
    },
    "brandIcon": {
      "type": "image",
      "value": "data:image/png;base64,"
    },
    "stickers": [
      {
        "type": "emoji",
        "value": "🌸",
        "x": 92,
        "y": 12,
        "size": 32,
        "rotation": 9,
        "scope": "welcome"
      }
    ],
    "customButtons": [
      {
        "label": "日期落款",
        "icon": "📅",
        "script": "const d = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\nawait app.insert(`\\n\\n> ${stamp} · 藕荷 · 晚照\\n`);\napp.toast('落款已插入');"
      },
      {
        "label": "选中成引",
        "icon": "❝",
        "script": "const picked = app.selection || '';\nif (!picked.trim()) { app.toast('先选中一段文字'); return; }\nconst quoted = picked.split('\\n').map((line) => `> ${line}`).join('\\n');\nawait app.replaceSelection(quoted);\napp.toast('已围成引用');"
      }
    ]
  }
}
