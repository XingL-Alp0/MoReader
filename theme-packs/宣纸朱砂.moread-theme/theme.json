{
  "format": "moread-theme",
  "version": 2,
  "name": "宣纸 · 朱砂",
  "home": {
    "enabled": true
  },
  "style": {
    "enabled": true
  },
  "theme": {
    "mode": "light",
    "primary": "#b23a28",
    "secondary": "#a87f3c",
    "componentColors": {
      "appBg": "#f2ebdd",
      "titlebarBg": "#f7f3eb",
      "sidebarBg": "#eae3d5",
      "surfaceBg": "#f8f3e9",
      "editorBg": "#f9f5ec",
      "paperBg": "#fdfaf3",
      "paperSoft": "#f6f0e5",
      "statusBg": "#f5efe2",
      "ink": "#2c2419",
      "inkSoft": "#5a5349",
      "muted": "#888279",
      "faint": "#a9a49c",
      "line": "#e6e2db",
      "lineSoft": "#efece5",
      "codeBg": "#f6f0e4",
      "codeInk": "#2c2419",
      "codeHead": "#f4eee1",
      "tableHead": "#f5efe2",
      "quoteBg": "#f3e8dc",
      "selection": "#e6c0b6",
      "diagramPrimary": "#b23a28",
      "diagramSecondary": "#a87f3c"
    },
    "brandIcon": {
      "type": "image",
      "value": "data:image/png;base64,"
    },
    "stickers": [
      {
        "type": "emoji",
        "value": "🖋",
        "x": 92,
        "y": 12,
        "size": 32,
        "rotation": 9,
        "scope": "welcome"
      }
    ],
    "customButtons": [
      {
        "label": "日期落款",
        "icon": "📅",
        "script": "const d = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\nawait app.insert(`\\n\\n> ${stamp} · 宣纸 · 朱砂\\n`);\napp.toast('落款已插入');"
      },
      {
        "label": "选中成引",
        "icon": "❝",
        "script": "const picked = app.selection || '';\nif (!picked.trim()) { app.toast('先选中一段文字'); return; }\nconst quoted = picked.split('\\n').map((line) => `> ${line}`).join('\\n');\nawait app.replaceSelection(quoted);\napp.toast('已围成引用');"
      }
    ]
  }
}
