{
  "format": "moread-theme",
  "version": 2,
  "name": "松烟 · 青苔",
  "home": {
    "enabled": true
  },
  "style": {
    "enabled": true
  },
  "theme": {
    "mode": "dark",
    "primary": "#86c9a0",
    "secondary": "#d8b97a",
    "componentColors": {
      "appBg": "#0c1310",
      "titlebarBg": "#161c1a",
      "sidebarBg": "#080c0a",
      "surfaceBg": "#101713",
      "editorBg": "#111814",
      "paperBg": "#131b16",
      "paperSoft": "#212924",
      "statusBg": "#0d1411",
      "ink": "#e3ebe4",
      "inkSoft": "#afb7b1",
      "muted": "#848c87",
      "faint": "#626965",
      "line": "#2e3631",
      "lineSoft": "#252d28",
      "codeBg": "#0f1713",
      "codeInk": "#e3ebe4",
      "codeHead": "#1b231f",
      "tableHead": "#161e1a",
      "quoteBg": "#17221b",
      "selection": "#436450",
      "diagramPrimary": "#86c9a0",
      "diagramSecondary": "#d8b97a"
    },
    "brandIcon": {
      "type": "image",
      "value": "data:image/png;base64,"
    },
    "stickers": [
      {
        "type": "emoji",
        "value": "🌲",
        "x": 92,
        "y": 12,
        "size": 32,
        "rotation": 9,
        "scope": "welcome"
      }
    ],
    "customButtons": [
      {
        "label": "日期落款",
        "icon": "📅",
        "script": "const d = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\nawait app.insert(`\\n\\n> ${stamp} · 松烟 · 青苔\\n`);\napp.toast('落款已插入');"
      },
      {
        "label": "选中成引",
        "icon": "❝",
        "script": "const picked = app.selection || '';\nif (!picked.trim()) { app.toast('先选中一段文字'); return; }\nconst quoted = picked.split('\\n').map((line) => `> ${line}`).join('\\n');\nawait app.replaceSelection(quoted);\napp.toast('已围成引用');"
      }
    ]
  }
}
