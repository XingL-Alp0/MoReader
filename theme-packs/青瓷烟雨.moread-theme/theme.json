{
  "format": "moread-theme",
  "version": 2,
  "name": "青瓷 · 烟雨",
  "home": {
    "enabled": true
  },
  "style": {
    "enabled": true
  },
  "theme": {
    "mode": "light",
    "primary": "#2f7a68",
    "secondary": "#a98a4e",
    "componentColors": {
      "appBg": "#ecf3f0",
      "titlebarBg": "#f4f8f6",
      "sidebarBg": "#e4eae8",
      "surfaceBg": "#f4f8f6",
      "editorBg": "#f6faf7",
      "paperBg": "#fbfdfb",
      "paperSoft": "#f1f6f4",
      "statusBg": "#f0f6f3",
      "ink": "#1f2e29",
      "inkSoft": "#4f5c57",
      "muted": "#808985",
      "faint": "#a3aaa7",
      "line": "#e3e6e4",
      "lineSoft": "#edf0ed",
      "codeBg": "#f1f6f4",
      "codeInk": "#1f2e29",
      "codeHead": "#eff5f2",
      "tableHead": "#f0f5f3",
      "quoteBg": "#e8f1ed",
      "selection": "#bed6cf",
      "diagramPrimary": "#2f7a68",
      "diagramSecondary": "#a98a4e"
    },
    "brandIcon": {
      "type": "image",
      "value": "data:image/png;base64,"
    },
    "stickers": [
      {
        "type": "emoji",
        "value": "🍵",
        "x": 92,
        "y": 12,
        "size": 32,
        "rotation": 9,
        "scope": "welcome"
      }
    ],
    "customButtons": [
      {
        "label": "日期落款",
        "icon": "📅",
        "script": "const d = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\nawait app.insert(`\\n\\n> ${stamp} · 青瓷 · 烟雨\\n`);\napp.toast('落款已插入');"
      },
      {
        "label": "选中成引",
        "icon": "❝",
        "script": "const picked = app.selection || '';\nif (!picked.trim()) { app.toast('先选中一段文字'); return; }\nconst quoted = picked.split('\\n').map((line) => `> ${line}`).join('\\n');\nawait app.replaceSelection(quoted);\napp.toast('已围成引用');"
      }
    ]
  }
}
