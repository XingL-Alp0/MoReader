{
  "format": "moread-theme",
  "version": 2,
  "name": "墨夜 · 深蓝",
  "home": {
    "enabled": true
  },
  "style": {
    "enabled": true
  },
  "theme": {
    "mode": "dark",
    "primary": "#7aa7f2",
    "secondary": "#e3b46e",
    "componentColors": {
      "appBg": "#0d1017",
      "titlebarBg": "#171a20",
      "sidebarBg": "#080a0f",
      "surfaceBg": "#11161e",
      "editorBg": "#12171f",
      "paperBg": "#151a23",
      "paperSoft": "#232830",
      "statusBg": "#0e1118",
      "ink": "#e6e9ef",
      "inkSoft": "#b2b5bb",
      "muted": "#878a90",
      "faint": "#64676d",
      "line": "#30353e",
      "lineSoft": "#272c34",
      "codeBg": "#11141c",
      "codeInk": "#e6e9ef",
      "codeHead": "#1d2027",
      "tableHead": "#181b23",
      "quoteBg": "#171e2a",
      "selection": "#3f557a",
      "diagramPrimary": "#7aa7f2",
      "diagramSecondary": "#e3b46e"
    },
    "brandIcon": {
      "type": "image",
      "value": "data:image/png;base64,"
    },
    "stickers": [
      {
        "type": "emoji",
        "value": "✧",
        "x": 92,
        "y": 12,
        "size": 32,
        "rotation": 9,
        "scope": "welcome"
      }
    ],
    "customButtons": [
      {
        "label": "日期落款",
        "icon": "📅",
        "script": "const d = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\nawait app.insert(`\\n\\n> ${stamp} · 墨夜 · 深蓝\\n`);\napp.toast('落款已插入');"
      },
      {
        "label": "选中成引",
        "icon": "❝",
        "script": "const picked = app.selection || '';\nif (!picked.trim()) { app.toast('先选中一段文字'); return; }\nconst quoted = picked.split('\\n').map((line) => `> ${line}`).join('\\n');\nawait app.replaceSelection(quoted);\napp.toast('已围成引用');"
      }
    ]
  }
}
